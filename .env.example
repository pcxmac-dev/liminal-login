# The login app's settings (copy to .env, or set them in the environment). No secrets go here:
# the users' passwords are never stored, and their keys live sealed in the stores.
# LIMINAL_LOGIN_PORT=8795                 the page's port on 127.0.0.1
# LIMINAL_LOGIN_DIR=                      the users' file and the stores (default: store/data/login of the workspace)
# LIMINAL_LOGIN_SESSION_MINUTES=480       a session ends after this long without a request
# LIMINAL_LOGIN_URL=http://127.0.0.1:8795 where the other programs reach the login app (liminal_libs.apps.LoginClient)
#
# The mail account the passkeys go through (liminal_libs.mail): set these in your user environment, with the
# password where you keep secrets, not in a file. Gmail: an app password; Proton: an SMTP token or Proton Bridge.
# LIMINAL_SMTP_HOST=smtp.gmail.com
# LIMINAL_SMTP_PORT=587
# LIMINAL_SMTP_SECURITY=starttls                  starttls, ssl, or none (Proton Bridge on this machine)
# LIMINAL_SMTP_USER=you@gmail.com
# LIMINAL_SMTP_PASSWORD=                          never written here
# LIMINAL_SMTP_FROM=Liminal <you@gmail.com>
